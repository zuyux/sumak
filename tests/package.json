{
  "name": "sumak-nft-tests",
  "version": "1.0.0",
  "description": "Rendezvous testing suite for SUMAK Audio NFT contracts",
  "scripts": {
    "test": "npm run test:xyz && npm run test:commission",
    "test:xyz": "rv . xyz-nft test",
    "test:xyz:verbose": "rv . xyz-nft test --runs=500",
    "test:xyz:invariant": "rv . xyz-nft invariant",
    "test:xyz:invariant:verbose": "rv . xyz-nft invariant --runs=1000",
    "test:commission": "rv . commission-mock test",
    "test:commission:verbose": "rv . commission-mock test --runs=500",
    "test:commission:invariant": "rv . commission-mock invariant",
    "test:commission:invariant:verbose": "rv . commission-mock invariant --runs=1000",
    "test:all": "npm run test && npm run test:xyz:invariant && npm run test:commission:invariant",
    "test:replay": "rv . xyz-nft test --seed=$SEED",
    "test:commission:replay": "rv . commission-mock test --seed=$SEED"
  },
  "keywords": [
    "clarity",
    "stacks",
    "nft",
    "testing",
    "rendezvous",
    "property-based-testing",
    "fuzzing"
  ],
  "author": "SUMAK Team",
  "license": "MIT",
  "devDependencies": {
    "@stacks/rendezvous": "^0.12.0"
  }
}
